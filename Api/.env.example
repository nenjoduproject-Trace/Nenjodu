# Set DATABASE_URL to the connection URL provided by your PostgreSQL provider.
DATABASE_URL=

# Render supplies PORT automatically. This default is for local development.
PORT=5000

# SSL is enabled by default in production. Set false only when your provider's
# database endpoint does not support SSL.
DATABASE_SSL=

# Set this to the deployed frontend origin if browser requests need CORS access.
FRONTEND_URL=

# For local development, the legacy DB_* variables are also supported:
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
